# ==============================================================================
# VaniRakshak — Comprehensive .gitignore
# Stack: Python (FastAPI, PyTorch/AI4Bharat/Whisper, Crawl4AI) + Node.js (Frontend)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets (CRITICAL SECURITY)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local
token.txt
hf_token.txt
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
secrets.json
credentials.json
service_account.json

# ------------------------------------------------------------------------------
# 2. Virtual Environments
# ------------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
**/venv/
**/.venv/
**/env/

# ------------------------------------------------------------------------------
# 3. Python Bytecode & Build Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------------------------------------------
# 4. Node.js & Frontend Dependencies
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.pnpm-store/

# ------------------------------------------------------------------------------
# 5. Temporary Audio Recordings & User Uploads
# ------------------------------------------------------------------------------
temp_audio/
tmp_audio/
recordings/
uploads/
*.tmp
*.temp
mic_*.wav
mic_*.webm
live_speech_*.wav
live_speech_*.webm

# Preserve official tracked audio samples
!test_audio/
!test_audio/**
!**/fact_app/static/samples/
!**/fact_app/static/samples/**

# ------------------------------------------------------------------------------
