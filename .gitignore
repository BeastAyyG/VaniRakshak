# ------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.code-workspace
.claude/
.context/
.cursor/
.cursorrules
.gemini/
.agents/

# ------------------------------------------------------------------------------
# 10. Operating System Junk
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
.directory
.fuse_hidden*
.Trash-*

