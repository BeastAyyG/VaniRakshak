<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions required to detect real incoming phone calls & analyze voice stream -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- Required from Android 14: an undeclared foreground service type makes
         startForeground() throw MissingForegroundServiceTypeException. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Scam-Shield Coercion Defense: warning overlay over banking apps & usage polling -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

    <!-- Lets the incoming-call alert surface over the lock screen. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Required to reach the VaniRakshak backend over `adb reverse tcp:8000 tcp:8000`
         (the app POSTs voice chunks to http://127.0.0.1:8000/v1/verify-speaker). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VaniRakshak">

        <!-- LAUNCHER: VaniRakshak Splash Screen -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.VaniRakshak.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MAIN APP: VaniRakshak Production Phone & AI Sentinel Main Activity -->
        <activity
            android:name=".VaniMainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <!-- InCallService for direct cellular calling UI inside VaniRakshak -->
        <service
            android:name=".service.VaniInCallService"
            android:permission="android.permission.BIND_INCALL_SERVICE"
            android:exported="true">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!-- Active Hero Calling Screen (Voice Visualizer + Live Transcription) -->
        <activity
            android:name=".calling.VaniActiveCallActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.VaniRakshak" />

        <!-- Post-Call Intelligence Summary Screen -->
        <activity
            android:name=".calling.VaniCallSummaryActivity"
            android:exported="true"
            android:theme="@style/Theme.VaniRakshak" />

        <!-- Call Record Detail Screen -->
        <activity
            android:name=".calling.VaniCallDetailActivity"
            android:exported="true"
            android:theme="@style/Theme.VaniRakshak" />

        <!-- Contact Detail Screen -->
        <activity
            android:name=".contacts.VaniContactDetailActivity"
            android:exported="true"
            android:theme="@style/Theme.VaniRakshak" />

        <!-- Voice Verification Activity -->
        <activity
            android:name=".verification.VoiceVerificationActivity"
            android:exported="true" />

        <!-- Factual Claim Result Activity -->
        <activity
            android:name=".verification.ClaimResultActivity"
            android:exported="true" />

        <!-- Scam Threat Result Activity -->
        <activity
            android:name=".verification.ScamResultActivity"
            android:exported="true" />

        <!-- One-Shot Audio Forensic File Inspector -->
        <activity
            android:name=".verification.FileForensicActivity"
            android:exported="true" />

        <!-- Production Contacts Roster Activity -->
        <activity
            android:name=".contacts.VaniContactsRosterActivity"
            android:exported="true"
            android:label="@string/app_name" />

        <!-- Production Live Call Forensic Screen -->
        <activity
            android:name=".contacts.VaniForensicDetailActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.VaniRakshak.Forensic" />

        <!-- Backward Compatibility Aliases for external intents or ADB shortcuts -->
        <activity-alias
            android:name="com.vericall.temp.TempContactsActivity"
            android:targetActivity=".contacts.VaniContactsRosterActivity"
            android:exported="true" />

        <activity-alias
            android:name="com.vericall.temp.TempContactDetailActivity"
            android:targetActivity=".contacts.VaniForensicDetailActivity"
            android:exported="false" />

        <!-- Real-Time Incoming Phone Call Receiver -->
        <receiver
            android:name=".receiver.VaniCallReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- Handles the notification actions (block & report) -->
        <receiver
            android:name=".receiver.VaniNotificationActionReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Modern detection path: Telecom binds this on Android 7+ as soon as
             the user grants the call screening role. -->
        <service
            android:name=".service.VaniCallScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- Owns the microphone during a call and publishes the live risk score -->
        <service
            android:name=".service.VaniCallGuardService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Scam-Shield OTP Interceptor: suppresses heads-up banking OTPs during high risk calls -->
        <service
            android:name=".shield.VaniOtpShieldService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Coercion Warning overlay fallback screen -->
        <activity
            android:name=".shield.VaniCoercionActivity"
            android:exported="false"
            android:launchMode="singleTop" />

    </application>

</manifest>
