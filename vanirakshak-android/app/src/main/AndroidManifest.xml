<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions required to detect real incoming phone calls & analyze voice stream -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Required from Android 14: an undeclared foreground service type makes
         startForeground() throw MissingForegroundServiceTypeException. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Scam-Shield Coercion Defense: warning overlay over banking apps & usage polling -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

    <!-- Lets the incoming-call alert surface over the lock screen. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Required to reach the VaniRakshak backend over `adb reverse tcp:8000 tcp:8000`
         (the app POSTs voice chunks to http://127.0.0.1:8000/v1/verify-speaker). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:icon="@drawable/ic_logo_vanirakshak"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_logo_vanirakshak"
        android:supportsRtl="true"
        android:theme="@style/Theme.VaniRakshak">

        <!-- LAUNCHER: VaniRakshak Main Activity -->
        <activity
            android:name=".temp.TempContactsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Live Call Voice-Clone Defense Screen -->
        <activity
            android:name=".temp.TempContactDetailActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:parentActivityName=".temp.TempContactsActivity" />

        <!-- Real-Time Incoming Phone Call Receiver -->
        <receiver
            android:name=".receiver.VaniCallReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- Handles the notification actions (block & report) -->
        <receiver
            android:name=".receiver.VaniNotificationActionReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Modern detection path: Telecom binds this on Android 7+ as soon as
             the user grants the call screening role. -->
        <service
            android:name=".service.VaniCallScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- Owns the microphone during a call and publishes the live risk score -->
        <service
            android:name=".service.VaniCallGuardService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Scam-Shield OTP Interceptor: suppresses heads-up banking OTPs during high risk calls -->
        <service
            android:name=".shield.VaniOtpShieldService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Coercion Warning overlay fallback screen -->
        <activity
            android:name=".shield.VaniCoercionActivity"
            android:exported="false"
            android:launchMode="singleTop" />

    </application>

</manifest>
