<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#2E1018" />
            <stroke android:width="1.5dp" android:color="#F43F5E" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#160D0E" />
            <stroke android:width="1dp" android:color="#4DF43F5E" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
