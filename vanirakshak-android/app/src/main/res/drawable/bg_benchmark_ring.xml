<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#0E262E" />
            <stroke android:width="1.5dp" android:color="#06B6D4" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#0C1417" />
            <stroke android:width="1dp" android:color="#4D06B6D4" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
