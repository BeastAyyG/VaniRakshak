<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Left accent bar -->
    <item android:width="4dp">
        <shape>
            <solid android:color="@color/accent_emerald" />
            <corners android:topLeftRadius="20dp" android:bottomLeftRadius="20dp" />
        </shape>
    </item>
    <!-- Card body -->
    <item android:left="4dp">
        <selector>
            <item android:state_pressed="true">
                <shape>
                    <solid android:color="#F0FDF9" />
                    <corners android:topRightRadius="20dp" android:bottomRightRadius="20dp" />
                    <stroke android:width="1dp" android:color="#A7F3D0" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="#FFFFFF" />
                    <corners android:topRightRadius="20dp" android:bottomRightRadius="20dp" />
                    <stroke android:width="1dp" android:color="#D1FAE5" />
                </shape>
            </item>
        </selector>
    </item>
</layer-list>
