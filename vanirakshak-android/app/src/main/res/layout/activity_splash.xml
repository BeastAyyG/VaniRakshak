<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <!-- Centered Brand Identity (Exact Website Neo-Brutalist Aesthetic) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Website Kicker Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_pill_neobrutal_paper"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="7dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.12"
                android:text="REAL-TIME VOICE-FRAUD SHIELD"
                android:textColor="@color/ink"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Elevated Squircle App Icon in Butter Yellow with Hard Shadow -->
        <FrameLayout
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:background="@drawable/bg_squircle_brand">

            <ImageView
                android:id="@+id/ivSplashLogo"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:contentDescription="VaniRakshak logo"
                android:src="@drawable/ic_logo_vanirakshak_splash" />
        </FrameLayout>

        <!-- Devnagari Brand Line from Website -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.14"
            android:text="वाणी रक्षक · THE GUARDIAN OF EVERY CALL"
            android:textColor="@color/ink_muted"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <!-- Brand Title: Vani + [Rakshak] Highlight Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.03"
                android:text="Vani"
                android:textColor="@color/ink"
                android:textSize="38sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_highlight_butter"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.03"
                android:paddingStart="12dp"
                android:paddingTop="2dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:text="Rakshak"
                android:textColor="@color/ink"
                android:textSize="38sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Primary Mandate: India's Shield Against Voice Scams -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.01"
            android:text="India’s Shield Against Voice Scams"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Indian Sovereign Identity Pill in Mint Green with Hard Shadow -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_pill_neobrutal_mint"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🇮🇳"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:text="BUILT FOR BHARAT · AI VOICE DEFENSE"
                android:textColor="@color/ink"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Loading Spinner in Coral -->
        <ProgressBar
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="28dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/coral" />
    </LinearLayout>

    <!-- Bottom Ticker Bar matching website footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_gravity="bottom"
        android:background="@color/ink"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:singleLine="true"
            android:text="✦ REAL-TIME TRANSCRIPT ✦ VOICE-DNA VERIFICATION ✦ SCAM-PATTERN LOCK ✦ DPDP ACT §8(7)"
            android:textColor="@color/paper"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
