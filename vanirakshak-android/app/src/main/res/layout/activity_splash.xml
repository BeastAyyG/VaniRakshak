<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0D14">

    <!-- Centered Brand Identity -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Official VaniRakshak Logo Asset -->
        <ImageView
            android:id="@+id/ivSplashLogo"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:contentDescription="VaniRakshak logo"
            android:src="@drawable/ic_logo_vanirakshak_splash" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.02"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:text="VOICE FORENSICS &amp; SCAM SHIELD"
            android:textColor="#94A3B8"
            android:textSize="10sp" />

        <!-- Minimal subtle loading indicator -->
        <ProgressBar
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="28dp"
            android:indeterminate="true"
            android:indeterminateTint="#10B981" />
    </LinearLayout>

    <!-- DPDP / Security Footer Notice -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:fontFamily="sans-serif"
        android:letterSpacing="0.02"
        android:text="DPDP Act §8(7) Compliant • Ephemeral Processing"
        android:textColor="#64748B"
        android:textSize="11sp" />

</FrameLayout>
