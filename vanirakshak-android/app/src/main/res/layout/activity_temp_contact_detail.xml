<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp">

        <!-- Top bar: white pill back button + sky LIVE badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_chip_white"
                android:contentDescription="Back"
                android:padding="12dp"
                android:src="@drawable/ic_back" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvLiveStreamBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_white"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:text="LIVE CALL"
                android:textColor="@color/info_deep"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Caller card: white melting into soft lavender -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_caller_gradient"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvCallerAvatar"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/circle_avatar_bg"
                android:gravity="center"
                android:text="A"
                android:textColor="@color/ink"
                android:textSize="30sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvCallerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.01"
                android:text="Aarav Sharma"
                android:textColor="@color/ink"
                android:textSize="23sp" />

            <TextView
                android:id="@+id/tvCallerPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="+91 98765 43210 - Brother"
                android:textColor="@color/mute"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCallTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_chip_accent"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:text="Live - streaming 16 kHz"
                android:textColor="@color/accent_deep"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Speakerphone Nudge Banner -->
        <LinearLayout
            android:id="@+id/cardSpeakerphonePrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_alert_warning"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Turn on Speakerphone"
                android:textColor="@color/warning_deep"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:lineSpacingExtra="2dp"
                android:text="Android restricts in-ear call recording. Turn on speakerphone so VaniRakshak can analyze the caller's acoustic voice stream."
                android:textColor="@color/ink"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTurnOnSpeaker"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginTop="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Enable Speakerphone"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Held Notifications Banner (Scam Shield) -->
        <LinearLayout
            android:id="@+id/cardHeldNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_alert_safe"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvHeldNotificationsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Banking Notifications Shielded"
                android:textColor="@color/success_deep"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Banking OTPs are protected from coercion. Tap below to safely review."
                android:textColor="@color/ink"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewHeldNotifications"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginTop="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Review Shielded Alerts"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Verdict card: rose pastel wash, oversized score -->
        <LinearLayout
            android:id="@+id/cardRiskContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_alert_danger"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="Voice-clone risk"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvRiskScoreNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="-0.02"
                    android:text="89%"
                    android:textColor="@color/error_tone"
                    android:textSize="40sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pbRiskMeter"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progress="89"
                android:progressTint="@color/error_deep" />

            <TextView
                android:id="@+id/tvVerdictTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="AI voice-clone impersonation"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvVerdictDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Synthetic vocoder artifacts detected. Speaker does not match the enrolled profile."
                android:textColor="@color/body"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvServerTier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="sans-serif-medium"
                android:text=""
                android:textColor="@color/mute"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvReceiptHash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text=""
                android:textColor="@color/mute"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Detection metrics: lavender card, hairline dividers -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="4dp"
            android:paddingEnd="18dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="13dp"
                android:paddingBottom="13dp">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_dot"
                    android:backgroundTint="@color/accent_sky" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Acoustic analysis"
                    android:textColor="@color/mute"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvMetricAcoustic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="94% synthetic"
                    android:textColor="@color/error_tone"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/hairline_soft" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="13dp"
                android:paddingBottom="13dp">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_dot"
                    android:backgroundTint="@color/pin_red" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Voice profile match"
                    android:textColor="@color/mute"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvMetricSpeaker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="26% match"
                    android:textColor="@color/error_tone"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/hairline_soft" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="13dp"
                android:paddingBottom="13dp">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_dot"
                    android:backgroundTint="@color/risk_low" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Telephony channel"
                    android:textColor="@color/mute"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvMetricChannel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="PSTN - 8 kHz"
                    android:textColor="@color/ink"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Liveness challenge (hidden until triggered) -->
        <LinearLayout
            android:id="@+id/cardChallengeBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_alert_warning"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Liveness challenge"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Defeats pre-recorded deepfakes. Ask the caller to repeat:"
                android:textColor="@color/mute"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvChallengePhrase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_chip_white"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:padding="16dp"
                android:text="Mango, 8, Nadi, 4, Blue"
                android:textColor="@color/accent_deep"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tvChallengeResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Analyzing caller response latency..."
                android:textColor="@color/warning_deep"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etChallengeResponse"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_chip_white"
                android:hint="Digits you hear, in order (e.g. 8 4)"
                android:importantForAutofill="no"
                android:inputType="number"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGradeChallenge"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Grade response"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Actions: violet CTA, indigo secondary, lavender tertiary -->
        <Button
            android:id="@+id/btnTriggerChallenge"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_primary"
            android:fontFamily="sans-serif-medium"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            android:text="Trigger liveness challenge"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btnBlockCall"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_dark"
            android:fontFamily="sans-serif-medium"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            android:text="Block call and report"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/btnInterlock"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_button_secondary"
            android:fontFamily="sans-serif-medium"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            android:text="Financial interlock"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="15sp"
            app:backgroundTint="@null" />

    </LinearLayout>
</ScrollView>
