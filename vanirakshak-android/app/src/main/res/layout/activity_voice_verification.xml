<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas_light"
    android:orientation="vertical">

    <!-- Top AppBar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btnBackVoice"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_chip_clean"
            android:contentDescription="Back"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="Verify a claim"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_clean"
            android:fontFamily="monospace"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="00:04"
            android:textColor="@color/brand_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Recording State View -->
    <LinearLayout
        android:id="@+id/layoutListeningState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:visibility="visible">

        <TextView
            android:id="@+id/tvListeningTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:letterSpacing="-0.02"
            android:text="Listening..."
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:text="Speak the spoken claim or call message naturally."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Aesthetic Condenser Mic Illustration with Reactive Ambient Glow -->
        <FrameLayout
            android:layout_width="200dp"
            android:layout_height="240dp"
            android:layout_marginTop="28dp">

            <ImageView
                android:id="@+id/ivAcousticMic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Studio Condenser Microphone"
                android:src="@drawable/vector_studio_condenser_mic" />
        </FrameLayout>

        <!-- Dynamic Waveform Indicator -->
        <LinearLayout
            android:id="@+id/layoutWaveform"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/bar1"
                android:layout_width="4dp"
                android:layout_height="12dp"
                android:layout_margin="2dp"
                android:background="@drawable/bg_badge_supported"
                android:backgroundTint="@color/brand_primary" />
            <View
                android:id="@+id/bar2"
                android:layout_width="4dp"
                android:layout_height="22dp"
                android:layout_margin="2dp"
                android:background="@drawable/bg_badge_supported"
                android:backgroundTint="@color/accent_emerald" />
            <View
                android:id="@+id/bar3"
                android:layout_width="4dp"
                android:layout_height="32dp"
                android:layout_margin="2dp"
                android:background="@drawable/bg_badge_supported"
                android:backgroundTint="@color/brand_primary" />
            <View
                android:id="@+id/bar4"
                android:layout_width="4dp"
                android:layout_height="16dp"
                android:layout_margin="2dp"
                android:background="@drawable/bg_badge_supported"
                android:backgroundTint="@color/accent_emerald" />
            <View
                android:id="@+id/bar5"
                android:layout_width="4dp"
                android:layout_height="28dp"
                android:layout_margin="2dp"
                android:background="@drawable/bg_badge_supported"
                android:backgroundTint="@color/brand_primary" />
            <View
                android:id="@+id/bar6"
                android:layout_width="4dp"
                android:layout_height="14dp"
                android:layout_margin="2dp"
                android:background="@drawable/bg_badge_supported"
                android:backgroundTint="@color/accent_emerald" />
        </LinearLayout>

        <!-- Stop & Verify Button -->
        <Button
            android:id="@+id/btnStopRecord"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/bg_hero_mic_button"
            android:fontFamily="sans-serif-medium"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            android:text="Stop &amp; Verify"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:backgroundTint="@null" />
    </LinearLayout>

    <!-- Transcribed & Analyzing State View -->
    <LinearLayout
        android:id="@+id/layoutAnalyzingState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:visibility="gone">

        <!-- "Here's what we heard" Card with Edit Option -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_clean"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.05"
                    android:text="HERE'S WHAT WE HEARD"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btnEditTranscript"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Edit"
                    android:textColor="@color/brand_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/inputTranscribedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@null"
                android:enabled="false"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="3dp"
                android:hint="Transcribing your speech in real time..."
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Stepped Progress Analysis Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_clean"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Verification in progress..."
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <!-- Step 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/iconStep1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓ "
                        android:textColor="@color/verdict_supported"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStep1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Speech recognized"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Step 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/iconStep2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✓ "
                        android:textColor="@color/verdict_supported"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStep2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Factual claim extracted"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Step 3 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/iconStep3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="◉ "
                        android:textColor="@color/brand_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStep3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Checking reliable sources..."
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Step 4 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/iconStep4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="○ "
                        android:textColor="@color/text_tertiary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvStep4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Comparing evidence..."
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Step 5 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/iconStep5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="○ "
                        android:textColor="@color/text_tertiary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvStep5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:text="Generating verdict..."
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <ProgressBar
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="18dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/brand_primary" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
