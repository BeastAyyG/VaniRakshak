<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginStart="14dp"
    android:layout_marginEnd="14dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_card_clean"
    android:padding="16dp">

    <!-- Top Row: Avatar, Caller Details & Risk Score Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Avatar -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/circle_avatar_clean">

            <TextView
                android:id="@+id/tvArchivedAvatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/neo_ink"
                tools:text="R" />
        </FrameLayout>

        <!-- Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvArchivedCallerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/neo_ink"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Rahul Sharma" />

            <TextView
                android:id="@+id/tvArchivedMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp"
                tools:text="Today • 4:32 PM • 02:15" />

            <TextView
                android:id="@+id/tvArchivedNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/text_tertiary"
                tools:text="+91 98765 43210" />
        </LinearLayout>

        <!-- Risk Score Pill Badge -->
        <LinearLayout
            android:id="@+id/pillArchivedRisk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_badge_supported"
            android:paddingStart="8dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <View
                android:id="@+id/dotArchivedRisk"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_dot"
                android:backgroundTint="@color/verdict_supported" />

            <TextView
                android:id="@+id/tvArchivedRiskText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/verdict_supported"
                tools:text="Safe • 12%" />
        </LinearLayout>
    </LinearLayout>

    <!-- Threat / Scam Classification Row (if detected) -->
    <LinearLayout
        android:id="@+id/layoutThreatAlert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_highlight_butter"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:layout_marginTop="10dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvThreatAlertText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/neo_ink"
            tools:text="🚨 Threat Detected: Bank KYC Phishing Scam" />
    </LinearLayout>

    <!-- High-Risk Evidence Preservation Marker (Risk >= 50%) -->
    <LinearLayout
        android:id="@+id/layoutProtectedEvidenceMarker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_pill_neobrutal_butter"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvProtectedMarkerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/neo_ink"
            android:text="Preserved Evidence: Audio WAV &amp; Transcript TXT archived on disk" />
    </LinearLayout>

    <!-- Audio Player Bar -->
    <LinearLayout
        android:id="@+id/layoutAudioPlayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card_inner"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/btnPlayPauseAudio"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_keypad_key_circle"
            android:src="@drawable/ic_play_arrow"
            android:contentDescription="Play Recording" />

        <SeekBar
            android:id="@+id/seekAudioProgress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/neo_ink"
            android:thumbTint="@color/neo_ink" />

        <TextView
            android:id="@+id/tvAudioDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:text="00:00 / 00:00" />
    </LinearLayout>

    <!-- Fallback if audio is missing/not recorded -->
    <TextView
        android:id="@+id/tvNoAudioMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="11sp"
        android:textColor="@color/text_tertiary"
        android:text="✦ Audio recording not captured for this call"
        android:visibility="gone" />

    <!-- Action Buttons Row: Transcript, Report, Call Back -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical">

        <!-- Transcript Button -->
        <TextView
            android:id="@+id/btnViewTranscript"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:background="@drawable/bg_pill_neobrutal_paper"
            android:text="📄 Transcript"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/neo_ink" />

        <!-- Report Button -->
        <TextView
            android:id="@+id/btnViewReport"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:background="@drawable/bg_pill_neobrutal_butter"
            android:text="🛡️ Safety Report"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/neo_ink" />

        <!-- Call Back Button -->
        <TextView
            android:id="@+id/btnCallBack"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center"
            android:background="@drawable/bg_pill_neobrutal_mint"
            android:text="📞 Call"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/neo_ink" />
    </LinearLayout>

</LinearLayout>
