<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- VaniRakshak Production Theme (Website Neo-Brutalist Palette) -->
    <style name="Theme.VaniRakshak" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ink</item>
        <item name="colorPrimaryVariant">@color/ink</item>
        <item name="colorOnPrimary">@color/paper</item>
        <item name="colorSecondary">@color/butter</item>
        <item name="colorSecondaryVariant">@color/butter_pressed</item>
        <item name="colorAccent">@color/coral</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper2</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <!-- Splash Screen Theme (Website Neo-Brutalist Paper Style) -->
    <style name="Theme.VaniRakshak.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Forensic Deep Telemetry Theme (Live Stream & Bayesian Analysis) -->
    <style name="Theme.VaniRakshak.Forensic" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_emerald</item>
        <item name="colorPrimaryVariant">@color/accent_emerald_border</item>
        <item name="colorOnPrimary">@color/canvas</item>
        <item name="colorSecondary">@color/accent_cyan</item>
        <item name="colorSecondaryVariant">@color/accent_cyan_border</item>
        <item name="colorAccent">@color/accent_emerald</item>
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:statusBarColor">@color/canvas</item>
        <item name="android:navigationBarColor">@color/canvas</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColor">@color/ink</item>
        <item name="fontFamily">sans-serif</item>
    </style>
</resources>