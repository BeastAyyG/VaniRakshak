<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The backend runs on the dev PC and is reached via `adb reverse tcp:8000 tcp:8000`,
         so it appears as localhost on the device. Allow cleartext HTTP to localhost only. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
