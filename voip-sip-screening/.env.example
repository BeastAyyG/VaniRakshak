# Provider credentials. Copy to .env and fill in. Never commit a filled .env.

# Scorer backend on lab-beast (already running there)
SCORER_HOST=100.89.248.108
SCORER_PORT=8000
SCORER_WS_PATH=/ws/stream

# Verdict policy (OPERATING_THRESHOLD is the verified scorer operating point;
# the rest are proposals to tune with live test calls)
OPERATING_THRESHOLD=21.9308
CHALLENGE_MARGIN=10.0
MIN_SPEECH_SECONDS=4.0
MAX_SCREEN_SECONDS=20.0

# This server's public base URL (must be https in production)
PUBLIC_BASE_URL=https://screen.example.com

# Active provider: exotel | plivo | twilio
PROVIDER=exotel

# Fill in only the section for your chosen provider
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# E.164 number to bridge allowed calls to (the user's phone)
USER_BRIDGE_NUMBER=

# Screening notice text version, logged per call as the consent record
NOTICE_VERSION=v1-en
